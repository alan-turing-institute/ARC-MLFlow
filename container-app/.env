##############
# MAYBE CHANGE
##############
PROJECT_NAME="turing"  # lowercase letters and numbers only, no special characters or spaces
TEAM_NAME="arc"  # lowercase letters and numbers only, no special characters or spaces
LOCATION="uksouth"  # Azure region
ALLOWED_IPS="$(curl -4 https://ifconfig.me)"  # Space-separated list of IPs. By default your own IP.
# MLflow Admin User (for accessing the MLflow UI)
MLFLOW_ADMIN_USERNAME="admin"
MLFLOW_ADMIN_PASSWORD="$(pwgen 64 1)"  # Auto-generated

###################
# NO NEED TO CHANGE
###################
RESOURCE_GROUP="${TEAM_NAME}-${PROJECT_NAME}-mlflow"
MLFLOW_FLASK_SERVER_SECRET_KEY="$(pwgen 64 1)"
# Artifact Storage Names
RND=$RANDOM
STORAGE_ACCOUNT_NAME="${TEAM_NAME}${PROJECT_NAME}mlflowsa${RND}"
STORAGE_CONTAINER_NAME="artifacts"
# PostgreSQL Configuration (used by MLflow server to connect to DB)
POSTGRES_SERVER_NAME="${RESOURCE_GROUP}-db-${RND}"
POSTGRES_ADMIN_USER="mlflowadmin"
POSTGRES_ADMIN_PASSWORD="$(pwgen 64 1)"  # Auto-generated
MLFLOW_DB_NAME="mlflow"
MLFLOW_DB_USER="mlflow_app"
MLFLOW_DB_USER_PASSWORD="$(pwgen 64 1)"  # Auto-generated
AUTH_DB_NAME="mlflow_auth_db"
AUTH_DB_USER="mlflow_auth"
AUTH_DB_USER_PASSWORD="$(pwgen 64 1)"  # Auto-generated
# Networking
MLFLOW_PORT="5000"
DB_PORT="5432"  # Postgres and PgBouncer port
# Misc names
ENVIRONMENT_NAME="mlflow-env"
CONTAINER_APP_NAME="${RESOURCE_GROUP}"
PGBOUNCER_APP_NAME="pgbouncer-app"
# Scale rules
CONTAINER_COOLDOWN_PERIOD="900"  # in seconds
CONTAINER_POLLING_INTERVAL="30"  # in seconds
